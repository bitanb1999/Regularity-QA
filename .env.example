HF_TOKEN=
GROQ_API_KEY=

POSTGRES_USER=rqa
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rqa
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

NEO4J_USER=neo4j
