# --- Langfuse (self-hosted, docker compose --profile observability) ---
# Tracing is skipped when LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY are empty.
# Generate the secrets below, e.g. `openssl rand -hex 32` for the encryption key.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@regulatory-qa.local
LANGFUSE_INIT_USER_PASSWORD=change_me
LANGFUSE_DB_PASSWORD=change_me
LANGFUSE_SALT=change_me
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=change_me
LANGFUSE_CLICKHOUSE_PASSWORD=change_me
LANGFUSE_REDIS_AUTH=change_me
LANGFUSE_MINIO_PASSWORD=change_me

# Contact sent in the scraper's User-Agent so FDA can reach you (e.g. your email)
SCRAPER_CONTACT=
